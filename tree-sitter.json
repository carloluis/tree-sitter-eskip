{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "eskip",
      "camelcase": "Eskip",
      "title": "Eskip",
      "scope": "source.eskip",
      "file-types": [
        "eskip"
      ],
      "injection-regex": "^eskip$",
      "class-name": "TreeSitterEskip"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "A descriptive configuration language designed for routing rules in Skipper",
    "authors": [
      {
        "name": "Carloluis",
        "email": "carloluisr@gmail.com",
        "url": "https://github.com/carloluis"
      }
    ],
    "links": {
      "repository": "https://github.com/carloluis/tree-sitter-eskip",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}